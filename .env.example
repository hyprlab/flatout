# Copy to .env and adjust. Everything is optional: Flatout starts with none
# of it set.

# Which image to run: latest (stable), beta, or a version such as 1.4.0.
IMAGE_TAG=latest

# Session signing key. If unset, one is generated and kept in the data
# directory, so sessions survive a restart.
SECRET_KEY=

# Set to 1 when the site is served over HTTPS, so session cookies are Secure.
SESSION_COOKIE_SECURE=0

# How many reverse proxies sit in front of Flatout. 0 trusts no
# X-Forwarded-* header; a number higher than the real one lets clients spoof
# their address. Behind one proxy that passes Host through, use 1.
TRUST_PROXY=0

# The largest Flatpak bundle accepted, in megabytes.
MAX_UPLOAD_MB=2048

# Cloudflare Turnstile for the sign-in page. Usually set up in the admin
# instead, under Settings > Security.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
